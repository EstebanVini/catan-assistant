# Copia este archivo a .env y ajusta los valores. NUNCA subas el .env real a git.

# Puerto del servidor (Express + Socket.IO)
PORT=3001

# Conexión a MongoDB.
# - Desarrollo local con mongo en Docker: mongodb://catan:catan-dev-password@localhost:27017/catan?authSource=admin
# - Todo en Docker (docker compose up): el compose la sobreescribe apuntando al servicio "mongo".
MONGODB_URI=mongodb://catan:catan-dev-password@localhost:27017/catan?authSource=admin

# Secreto para firmar los JWT. Usa un valor largo y aleatorio en producción.
JWT_SECRET=change-me-to-a-long-random-string

# Credenciales del contenedor de MongoDB (usadas por docker-compose)
MONGO_INITDB_ROOT_USERNAME=catan
MONGO_INITDB_ROOT_PASSWORD=catan-dev-password
